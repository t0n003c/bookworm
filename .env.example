# BookWorm environment — copy to .env and fill in real values.
#   cp .env.example .env
# Never commit the real .env (it is gitignored). Every var below is OPTIONAL:
# the app boots with the defaults shown if .env is absent.

# ── Data directory ─────────────────────────────────────────────────────
# Where bookworm.db + uploads live. Local default: "." | Docker: /data
BW_DATA_DIR=.

# ── Secret key ─────────────────────────────────────────────────────────
# Signs sessions AND encrypts stored LLM API keys. If unset, it is auto-
# generated and persisted to <BW_DATA_DIR>/bookworm.secret on first boot.
# Set it in production so sessions/keys survive a volume replacement.
# Changing it invalidates all sessions and makes stored LLM keys unreadable.
BW_SECRET_KEY=

# ── HTTPS / reverse proxy ──────────────────────────────────────────────
# BW_HTTPS=true   → secure-only cookies (enable behind a TLS proxy).
# BW_TRUST_PROXY  → read X-Forwarded-Proto/For (enable behind nginx/Caddy/etc).
BW_HTTPS=false
BW_TRUST_PROXY=false

# ── Accounts ───────────────────────────────────────────────────────────
# Allow new users to self-register (true/false). Seeds site_settings once.
BW_ALLOW_REGISTRATION=true
# Demo mode — guards global-table writes (true/false).
BW_DEMO_ENABLED=true

# ── Uploads ────────────────────────────────────────────────────────────
# Max upload size in MB (images + videos).
BW_MAX_UPLOAD_MB=200

# ── Biometric / Passkey (WebAuthn) ─────────────────────────────────────
# Needed behind a TLS proxy (set BW_HTTPS=true). Otherwise auto-detected.
# RP ID  = bare domain      e.g. notes.example.com
# Origin = full browser URL e.g. https://notes.example.com
BW_WEBAUTHN_RP_ID=
BW_WEBAUTHN_ORIGIN=

# ── Web Push (VAPID) ───────────────────────────────────────────────────
# Generate a keypair once with: python gen_vapid_keys.py
# Leave all three empty to disable push notifications entirely.
BW_VAPID_PRIVATE_KEY=
BW_VAPID_PUBLIC_KEY=
BW_VAPID_SUBJECT=mailto:admin@localhost

# ── Collabora Online (edit documents in browser, optional) ─────────────
# BW_COLLABORA_URL : URL the browser uses to reach Collabora (e.g. http://localhost:9980).
# BW_WOPI_BASE_URL : URL Collabora uses to call back into BookWorm (server-to-server).
# Leave empty to hide the "Edit in Collabora" feature.
BW_COLLABORA_URL=
BW_WOPI_BASE_URL=
BW_WOPI_TOKEN_EXPIRY=3600

# ── Outbound HTTP proxy (optional) ─────────────────────────────────────
# Set when behind a corporate proxy intercepting outbound HTTP/HTTPS
# (affects RSS, weather, image proxy, link previews). Empty = direct.
BW_HTTP_PROXY=

# ── Login rate limiting (optional) ─────────────────────────────────────
# 5 failed logins within a 600s window → 900s lockout (defaults shown).
BW_RL_WINDOW_SECS=600
BW_RL_MAX_FAILURES=5
BW_RL_LOCKOUT_SECS=900

# ── Cloudflare Turnstile bot challenge (optional fallback) ─────────────
# Preferred setup: sign in as superadmin -> Account -> Admin -> Site Settings.
# These env keys are fallback/default keys for deployment-managed installs.
# Existing env-key installs stay enabled; the account setting can turn it off.
# Create a widget at:
#   https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public; keep the secret key private. Leave empty to disable.
BW_TURNSTILE_SITE_KEY=
BW_TURNSTILE_SECRET_KEY=
