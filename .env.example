# BookWorm — environment variable reference
# Copy this to .env and fill in your values.
# docker compose automatically loads .env from the same directory.
# NEVER commit .env to git (it's already in .gitignore).

# ── Required ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BW_SECRET_KEY=replace-me-with-a-long-random-string

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Set to "true" when behind a TLS proxy (nginx, Caddy, Traefik).
# Enables Secure flag on session cookies.
BW_HTTPS=false

# Seeds the initial registration setting on first boot only.
# After that, toggle it live in the superadmin account panel (no restart needed).
# "true"  = anyone with the URL can self-register.
# "false" = closed — only the superadmin can create accounts manually.
BW_ALLOW_REGISTRATION=true

# "false" = hide the Try Demo button and disable the /demo/start route.
BW_DEMO_ENABLED=true

# Number of uvicorn workers. 1 is safe for SQLite. Max ~4 with WAL mode.
# Migrate to PostgreSQL if you need more than 4.
WORKERS=1
