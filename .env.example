# BookWorm — environment variable reference
# Copy this to .env and fill in your values.
# docker compose automatically loads .env from the same directory.
# NEVER commit .env to git (it's already in .gitignore).

# ── Secret key (optional — auto-generated on first boot) ────────────────────────────
# The app generates a random key and saves it to /data/bookworm.secret on
# first boot, so you can run `docker compose up -d` with no .env at all.
#
# Set this for production so sessions survive if the volume is ever replaced.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BW_SECRET_KEY=

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Set to "true" when behind a TLS proxy (nginx, Caddy, Traefik, Cloudflare Tunnel,
# Nginx Proxy Manager, etc.).  Enables Secure flag on session cookies.
BW_HTTPS=false

# Set to "true" when a reverse proxy sits in front of BookWorm.
# Enables reading of X-Forwarded-Proto / X-Forwarded-For headers so
# BookWorm knows it's on HTTPS and sees real visitor IPs.
# ⚠️  Do NOT enable if BookWorm is exposed directly to the internet (no proxy).
# Nginx Proxy Manager / Cloudflare Tunnel users: set BOTH BW_TRUST_PROXY and BW_HTTPS to true.
#
# Docker note: NPM runs in its own container and reaches BookWorm via Docker's
# bridge network, so the proxy source IP is never 127.0.0.1 — BookWorm accepts
# forwarded headers from any upstream when this flag is true (safe because
# BookWorm should not be directly reachable from the internet when proxied).
BW_TRUST_PROXY=false

# ── Cloudflare Tunnel quick-start ────────────────────────────────────────────
# 1. Install cloudflared and authenticate:  cloudflared tunnel login
# 2. Create a tunnel:                       cloudflared tunnel create bookworm
# 3. Route your domain:                     cloudflared tunnel route dns bookworm your.domain.com
# 4. Set these env vars in your .env:
#      BW_HTTPS=true
#      BW_TRUST_PROXY=true
#      BW_SECRET_KEY=<long random string>
# 5. Run the tunnel:  cloudflared tunnel run --url http://localhost:8001 bookworm
#
# Existing installs (from localhost) will NOT auto-migrate to the new URL.
# Users must visit the new public URL and reinstall the PWA from there.
# Fresh installs from the Cloudflare URL work out of the box.

# Seeds the initial registration setting on first boot only.
# After that, toggle it live in the superadmin account panel (no restart needed).
# "true"  = anyone with the URL can self-register.
# "false" = closed — only the superadmin can create accounts manually.
BW_ALLOW_REGISTRATION=true

# "false" = hide the Try Demo button and disable the /demo/start route.
BW_DEMO_ENABLED=true

# Max file size per upload in megabytes (images + videos).
# 200 MB default handles most phone videos. Raise to 500+ for large MP4s.
BW_MAX_UPLOAD_MB=200

# Number of uvicorn workers. 1 is safe for SQLite. Max ~4 with WAL mode.
# Migrate to PostgreSQL if you need more than 4.
WORKERS=1

# ── Outbound HTTP proxy (optional) ───────────────────────────────────────────────
# Set when BookWorm is deployed inside a corporate network that requires
# outbound HTTP/HTTPS traffic to pass through a proxy.
# Affects: RSS feed fetching, weather widget, image proxy, link previews.
# Leave empty for direct internet access (the default for most deployments).
# Format: http://proxy.example.com:8080  (or http://user:pass@proxy:port)
BW_HTTP_PROXY=

# ── Collabora Online (optional — LibreOffice in browser) ──────────────────────
# Leave BW_COLLABORA_URL empty to hide the "Edit in Collabora" button.
#
# Docker full-stack setup (collabora service in docker-compose.yml):
#   BW_COLLABORA_URL=http://<host-ip>:9980   (browser-facing; uncomment ports in compose)
#   BW_WOPI_BASE_URL=http://bookworm:8001    (Collabora → BookWorm on Docker bridge)
#
# Local dev (BookWorm local + Collabora in Docker with 9980 exposed):
#   BW_COLLABORA_URL=http://localhost:9980
#   BW_WOPI_BASE_URL=http://host.docker.internal:8000
#
# ⚠️  TLS note: If BookWorm is on HTTPS, BW_COLLABORA_URL must also be HTTPS.
#    Mixed-content rules will block a plain-HTTP iframe on an HTTPS page.
#    Use a reverse proxy with TLS in front of Collabora for production.
BW_COLLABORA_URL=
BW_WOPI_BASE_URL=
BW_WOPI_TOKEN_EXPIRY=3600
