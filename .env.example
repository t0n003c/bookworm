# BookWorm environment — copy to .env and fill in real values.
#   cp .env.example .env
# Never commit the real .env (it is gitignored).

# ── Web Push (VAPID) ───────────────────────────────────────────────────
# Generate a keypair with: python gen_vapid_keys.py
BW_VAPID_PRIVATE_KEY=your-vapid-private-key-here
BW_VAPID_PUBLIC_KEY=your-vapid-public-key-here
BW_VAPID_SUBJECT=mailto:you@example.com

# ── Data directory ─────────────────────────────────────────────────────
# Where bookworm.db lives. Local default: "." | Docker: /data
BW_DATA_DIR=.

# ── Registration ───────────────────────────────────────────────────────
# Allow new users to self-register (true/false). Seeds site_settings on first boot.
BW_ALLOW_REGISTRATION=true
