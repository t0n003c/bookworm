# ── Secrets & local config ─────────────────────────────────────────────
.env
*.secret
*_cookies.txt
_qa*.txt

# ── Databases & user data (mounted as a volume, not baked into the image)
*.db
uploads/

# ── Logs ───────────────────────────────────────────────────────────────
*.log

# ── Generated ML artifacts (rebuilt at runtime) ────────────────────────
bw_tfidf_*.pkl

# ── Python / virtualenv ────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── Version control & tooling ──────────────────────────────────────────
.git/
.gitignore
.claude/

# ── Windows-only Tailwind binary (Linux image builds CSS differently) ──
tailwindcss.exe

# ── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
