# Keep the Docker image lean — none of these belong inside it.

# Dev environment
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# Data (persisted via Docker volume at runtime, not baked into image)
*.db
*.sqlite
*.sqlite3
uploads/

# Logs
*.log

# Secrets (never bake credentials into the image)
*.secret
cookies.txt
cookies*.txt

# Git history (not needed at runtime)
.git/
.gitignore

# OS junk
.DS_Store
Thumbs.db

# All dev / test / debug scripts
_check_*.py
_qa_*.py
_migrate_*.py
_test_*.py
_jscheck.py
check_*.py
_tmp*.py
_debug*.py
diag*.py
tail_log.py
test_*.py
template_test.py
smoke_test.py

# Temp data dumps
openapi_tmp.json
openapi_*.json
*.tmp.json

# Tailwind CLI binary (Windows-only, not needed in Linux Docker image)
tailwindcss.exe
tailwindcss-windows-x64.exe

# This file itself
.dockerignore